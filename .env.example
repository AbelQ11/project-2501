# ==============================================================================
# PROJECT 2501 // CYBERBRAIN NETWORK MONITOR & ANALYTICS CONFIGURATION
# Copy this file to .env and fill in your own values (or run scripts/setup.sh).
# ==============================================================================

# [NETWORK PERIMETER]
INTERFACE=eth0
SERVER_PUBLIC_IP=203.0.113.10

# [CHANNEL 1: EXAMPLE SITE]
CHANNEL_1_NAME=example-site
CHANNEL_1_DOMAIN=example.com
CHANNEL_1_LOG=/var/log/nginx/example.com_access.log

# [CHANNEL 2: SECOND SITE]
CHANNEL_2_NAME=second-site
CHANNEL_2_DOMAIN=second.example.com
CHANNEL_2_LOG=/var/log/nginx/second.example.com_access.log

# [GLOBAL FALLBACK LOG]
GLOBAL_FALLBACK_LOG=/var/log/nginx/access.log

# [ANOMALY THRESHOLDS]
SYN_FLOOD_THRESHOLD=30
SYN_WINDOW_SECONDS=5
SCAN_404_THRESHOLD=15
SCAN_WINDOW_SECONDS=10
ALERT_COOLDOWN_MINUTES=15

# [FIREWALL ACTIVE DEFENSE (FAIL2BAN IPS)]
FIREWALL_ENABLED=true
BAN_DURATION_MINUTES=60
# Comma-separated IPs or CIDRs that must never be banned (loopback and RFC1918
# ranges are always protected automatically).
IP_WHITELIST=

# [DISCORD WEBHOOK ALERTING]
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# [SMTP TLS EMAIL ALERTING]
# Port 465 uses implicit TLS (SMTPS); port 587 uses STARTTLS.
SMTP_ENABLED=false
SMTP_URL=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=alerts@example.com
SMTP_PASS=your_password_here
ALERT_TO=admin@example.com

# [STORAGE & DASHBOARD SERVER]
DB_PATH=cyberbrain.db
DASHBOARD_PORT=2501
# Keep the dashboard on loopback and reach it through an SSH tunnel.
DASHBOARD_BIND=127.0.0.1

# [PRIVACY / GEOIP]
# Secret used to hash visitor IP + User-Agent. Generate with:
#   head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'
VISITOR_SALT=replace_with_a_random_hex_string
# Optional MaxMind GeoLite2/GeoIP2 Country database. Leave empty to use the
# approximate first-octet fallback.
GEOIP_DB_PATH=
